# Copy to api/.env and fill in from the Supabase dashboard. .env is gitignored;
# never commit real keys, and never put the service_role key in a browser build.

# Project Settings -> API. The anon key is enough: the courses table is
# public-read and nothing writes through the api.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Project Settings -> Database -> Connection string (URI), with your database
# password substituted in. Only migrate.py uses this; the running api does not.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
