# Copy to api/.env and fill in from the Supabase dashboard. .env is gitignored;
# never commit real keys, and never put the service_role key in a browser build.

# Project Settings -> API Keys. The publishable key is enough: the courses
# table is public-read and nothing writes through the api. A legacy anon key
# works too. Never the secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_...

# The Connect button at the top of the dashboard -> Session pooler (port 5432),
# with [YOUR-PASSWORD] replaced by your database password. migrate.py holds one
# long-lived connection, so session mode, not the 6543 transaction pooler.
# Only migrate.py uses this; the running api never touches Postgres directly.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
